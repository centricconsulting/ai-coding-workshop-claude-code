// Spring Boot Participant DevContainer - Streamlined for Workshop Participants
// For participants following the Spring Boot track
{
    "name": "Claude Code Workshop - Spring Boot Participant",
    "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",

    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "jdkDistro": "ms",
            "installMaven": "true",
            "installGradle": "true",
            "mavenVersion": "3.9",
            "gradleVersion": "8.5"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest",
            "installDirectlyFromGitHubRelease": "false"
        },
        // Node.js is only needed for npx-based MCP servers in Lab 10 (Claude Code uses the native installer)
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },

    // Claude Code native installer -> ~/.local/bin/claude (auto-updates; no Node.js needed)
    "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash && mvn clean install -f src-springboot/pom.xml -DskipTests",

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "humao.rest-client",
                "vscjava.vscode-java-pack",
                "vscjava.vscode-spring-boot-dashboard",
                "vmware.vscode-spring-boot",
                "vscjava.vscode-maven",
                "vscjava.vscode-gradle",
                "bierner.markdown-mermaid",
                "marp-team.marp-vscode",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-21",
                        "default": true
                    }
                ],
                "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
            }
        }
    },

    // Put the native installer's bin dir on PATH and forward Claude Code credentials from the host.
    // Set ONE of these on the host before opening the container (or run `claude` and use /login inside it):
    //   ANTHROPIC_API_KEY       - Claude Console API key
    //   CLAUDE_CODE_OAUTH_TOKEN - Claude subscription token from `claude setup-token`
    "remoteEnv": {
        "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
    },

    "forwardPorts": [8080, 8443],
    "portsAttributes": {
        "8080": {
            "label": "Spring Boot HTTP"
        },
        "8443": {
            "protocol": "https",
            "label": "Spring Boot HTTPS"
        }
    }
}
