// Workshop Maintainer DevContainer - Full Toolchain
// For workshop authors and maintainers working with BOTH .NET and Spring Boot
{
    "name": "Claude Code Workshop - Maintainer (Full Toolchain)",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

    "features": {
        "ghcr.io/devcontainers/features/dotnet:1": {
            "version": "9.0",
            "installUsingApt": false
        },
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "jdkDistro": "ms",
            "installMaven": "true",
            "installGradle": "true",
            "mavenVersion": "3.9",
            "gradleVersion": "8.5"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest",
            "installDirectlyFromGitHubRelease": "false"
        },
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest"
        },
        // Node.js is only needed for Marp CLI (Claude Code itself uses the native installer)
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },

    // Claude Code native installer -> ~/.local/bin/claude (auto-updates; no Node.js needed)
    "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash && npm install -g @marp-team/marp-cli && dotnet build src-dotnet/TaskManager.sln && mvn clean install -f src-springboot/pom.xml -DskipTests && dotnet dev-certs https --trust",

    "customizations": {
        "vscode": {
            "extensions": [
                // Claude Code
                "anthropic.claude-code",

                // .NET Development
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",

                // Java Development
                "vscjava.vscode-java-pack",
                "vscjava.vscode-spring-boot-dashboard",
                "vmware.vscode-spring-boot",
                "vscjava.vscode-spring-initializr",
                "vscjava.vscode-maven",
                "vscjava.vscode-gradle",

                // API Testing
                "humao.rest-client",

                // Documentation & Presentations
                "bierner.markdown-mermaid",
                "marp-team.marp-vscode",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-21",
                        "default": true
                    }
                ],
                "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current"
            }
        }
    },

    // Put the native installer's bin dir on PATH and forward Claude Code credentials from the host.
    // Set ONE of these on the host before opening the container (or run `claude` and use /login inside it):
    //   ANTHROPIC_API_KEY       - Claude Console API key
    //   CLAUDE_CODE_OAUTH_TOKEN - Claude subscription token from `claude setup-token`
    "remoteEnv": {
        "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
    },

    "forwardPorts": [5000, 5001, 8080, 8443],
    "portsAttributes": {
        "5001": {
            "protocol": "https",
            "label": ".NET HTTPS"
        },
        "5000": {
            "label": ".NET HTTP"
        },
        "8080": {
            "label": "Spring Boot HTTP"
        },
        "8443": {
            "protocol": "https",
            "label": "Spring Boot HTTPS"
        }
    }
}
