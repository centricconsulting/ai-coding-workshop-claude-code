{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "This file is a TEACHING ARTIFACT for Lab 9. It demonstrates Claude Code permissions (allow/ask/deny) and hooks. Hooks read their input as JSON on stdin and require jq. Participants study and modify it during the workshop.",

  "permissions": {
    "allow": [
      "Bash(dotnet *)",
      "Bash(mvn *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(dotnet ef *)",
      "Bash(mvn flyway*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\\(now | todate)] Bash: \\(.tool_input.command)\"' >> \"${CLAUDE_PROJECT_DIR}/.claude/audit.log\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\\(now | todate)] \\(.tool_name): \\(.tool_input.file_path)\"' >> \"${CLAUDE_PROJECT_DIR}/.claude/audit.log\""
          }
        ]
      }
    ]
  }
}
